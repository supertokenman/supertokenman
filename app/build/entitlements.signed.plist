<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's JavaScript engine compiles code at runtime -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <!-- no disable-library-validation: with a Developer ID every bundled binary (Claude Code, node-pty) is signed by the same team -->
  <!-- Meet, Teams, Slack and WhatsApp calls in the Apps drawer, and dictation in panels -->
  <key>com.apple.security.device.camera</key><true/>
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- Spotify through AppleScript -->
  <key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>

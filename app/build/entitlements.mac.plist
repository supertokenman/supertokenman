<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's JavaScript engine compiles code at runtime -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <!-- an ad-hoc signed app loads its own frameworks and the bundled Claude Code binary -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <!-- Meet, Teams, Slack and WhatsApp calls in the Apps drawer -->
  <key>com.apple.security.device.camera</key><true/>
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- Spotify through AppleScript -->
  <key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>
